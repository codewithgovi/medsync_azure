{
	"name": "PL_SEND_EMAIL",
	"properties": {
		"activities": [
			{
				"name": "Read All Tables",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * from ctrl.audit_log where adf_run_id = '@{pipeline().parameters.adf_run_id}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Prepare Email body Header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_header",
					"value": "Ingestion and Transformation has been completed for medsync project."
				}
			},
			{
				"name": "Prepare Email body Footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_footer",
					"value": "For any support. Please reach out to team@gmail.com"
				}
			},
			{
				"name": "Prepare Email Subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Check over all failed count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().globalParameters.env} | @{if(greater(activity('Check over all failed count').output.firstRow.count, 0), 'FAILED', 'SUCCESS')} | MEDSYNC MASTER RUN",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check over all failed count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT count(*) as count from ctrl.audit_log where adf_run_id = '@{pipeline().parameters.adf_run_id}'\nand status !='SUCCESS'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Prepare Logic Apps Body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare Email Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email body Footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare Email body Header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Read All Tables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n\"subject\":\"@{variables('email_subject')}\",\n\"email_receipients\":\"@{pipeline().globalParameters.email_receipent}\",\n\"body_header\":\"@{variables('body_header')}\",\n\"body_footer\":\"@{variables('body_footer')}\",\n\"status_table\":@{activity('Read All Tables').output.value}\n}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "4e694ebe-b220-4947-81c0-72d7591bef79"
			}
		},
		"variables": {
			"Body Header": {
				"type": "String"
			},
			"body_header": {
				"type": "String"
			},
			"body_footer": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"logic_apps_body": {
				"type": "String"
			}
		},
		"annotations": []
	}
}